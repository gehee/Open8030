#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Build, test and run Open8030."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / 'tools'))
import build
import vrx


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    firmware = commands.add_parser('build', help='Build runtime, bootstrap and packaged VRX image')
    firmware.add_argument('--prepare', action='store_true', help='Download/install pinned build dependencies')
    firmware.add_argument('--profile', type=Path, default=ROOT / '.local/board-profile.c')
    for name, help_text in (
        ('run', 'Copy, start and leave Open8030 running on the VRX'),
        ('stop', 'Restore the original VRX radio and video services'),
        ('status', 'Check replacement firmware identity and RF link'),
    ):
        command = commands.add_parser(name, help=help_text)
        command.add_argument('host', type=vrx.validate_host)
    image = commands.add_parser('image', help='Build one firmware image from a board profile')
    image.add_argument('--profile', type=Path, required=True, help='Board profile C data')
    image.add_argument('--output', type=Path, required=True)
    image.add_argument('--cflags', default='', help='e.g. "-DAR_ROLE_AP -DAR_FACTORY_OPTIONAL" for an AP')
    image.add_argument('--zephyr', type=Path, help='Zephyr tree (default: the pinned local one)')
    image.add_argument('--toolchain', type=Path, help='riscv64-zephyr-elf toolchain directory')
    image.add_argument('--python', type=Path, help='Python with the build requirements')
    image.add_argument('--build-dir', type=Path)
    commands.add_parser('test', help='Run native C and Python tests offline')
    qemu = commands.add_parser('qemu', help='Build and exercise the protocol in QEMU')
    qemu.add_argument('--prepare', action='store_true')
    args = parser.parse_args()
    if args.command == 'build':
        if not args.profile.is_file():
            raise ValueError(f'Missing private board profile: {args.profile}')
        if args.prepare:
            build.prepare()
        build.build_release(args.profile)
    elif args.command == 'image':
        build.build_image(args.profile, args.output, args.cflags, args.zephyr, args.toolchain,
                          args.python, args.build_dir)
    elif args.command == 'qemu':
        if args.prepare:
            build.prepare()
        build.build('qemu_riscv32', '')
        subprocess.run([sys.executable, str(ROOT / 'tests/qemu.py'),
                        '--qemu', str(build.SDK / 'hosttools/sysroots/x86_64-pokysdk-linux/usr/bin/qemu-system-riscv32'),
                        '--elf', str(build.LOCAL / 'build-qemu-ready/zephyr/zephyr.elf')], check=True)
    elif args.command == 'test':
        subprocess.run([sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-v'], cwd=ROOT, check=True)
        subprocess.run([sys.executable, str(ROOT / 'tests/native.py')], check=True)
    elif args.command == 'status':
        print(json.dumps(vrx.check(args.host), indent=2))
    else:
        {'run': vrx.run_vrx, 'stop': vrx.stop_vrx}[args.command](args.host)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, EOFError, subprocess.CalledProcessError) as error:
        raise SystemExit(f'Error: {error}')
